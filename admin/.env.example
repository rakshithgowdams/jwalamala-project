# The public news site this admin manages. Used for "back to the news site",
# links to public pages and password-reset emails, which finish on that site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
# Same Supabase project as the news site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ImageKit links (https://ik.imagekit.io/...) always work. Set this only for a
# custom ImageKit domain; both apps must use the same value.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IP_HASH_SECRET=
TRUST_PROXY_IP=false

# Providers the admin can drive (enable each in /admin/providers)
OPENAI_API_KEY=
OPENAI_MODEL=
SARVAM_API_KEY=
RESEND_API_KEY=
NEWSLETTER_FROM=
# 64 hexadecimal characters (32 random bytes), server-only
SOCIAL_ENCRYPTION_KEY=
FACEBOOK_GRAPH_VERSION=
VAPID_PRIVATE_KEY=
TURNSTILE_SECRET_KEY=
OPEN_METEO_API_KEY=
# Shown on the ad settings screen; set to match the news site.
ADS_STRICT_CSP=false

# Optional branding, as on the news site
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_FULL_NAME=
NEXT_PUBLIC_SITE_ENGLISH_NAME=
NEXT_PUBLIC_SITE_HINDI_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_ENGLISH_DESCRIPTION=
NEXT_PUBLIC_SITE_HINDI_DESCRIPTION=
NEXT_PUBLIC_SITE_LOGO=
